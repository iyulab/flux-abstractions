<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Flux.Abstractions</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Shared abstractions for the Flux ecosystem - IEnrichedChunk, ISourceMetadata, and related interfaces for RAG data pipeline interoperability</Description>
    <PackageTags>RAG;Flux;Abstractions;Interfaces;Chunks;Metadata</PackageTags>
  </PropertyGroup>

  <!-- CLS compliance for consumers like FileFlux -->
  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    No dependencies - pure interfaces only. This is load-bearing rather than incidental:
    every package in the ecosystem sits above this one, so anything referenced here would
    become a version floor for all of them.
  -->

</Project>
